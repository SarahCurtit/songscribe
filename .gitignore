__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

.venv/
venv/
env/

.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/

# Local audio and model files -- never commit these.
audio/
samples/
*.mp3
*.wav
*.flac
*.m4a
*.ogg
*.aac
models/
*.pt
*.ckpt
*.onnx
separated/

# Generated transcriptions
out/
*.cho
*.chopro

# Evaluation: manifests, reference annotations and model estimates, none of
# which belong in the repo -- a manifest lives with its corpus, the annotations
# are other people's work, the estimates come from audio. The whole directory
# goes: it is the habitual `manifest --output` target. The leading slash
# matters: plain `eval/` would also ignore src/songscribe/eval/.
/eval/
*.lab
annotations/
estimates/
.eval-cache/
# Word timelines for placement scoring hold lyric text, which hard constraint 5
# keeps out of the repo. songscribe.eval.reference refuses to write any other
# suffix, so this one rule covers them all.
*.words.json
# Corpora land here: downloaded annotation archives and their extracted trees.
# Anchored like /eval/ above, so tests/data/ and src/songscribe/data/ stay addable.
# Ignored wholesale rather than by extension, because Isophonics also ships
# .ttl, .svl and .txt alongside the .lab files.
/data/

.DS_Store
.idea/
.vscode/
*.swp

.claude/settings.local.json
.claude/worktrees/
